{
  "name": "web-svc",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/web-svc",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "forwardPorts": [8000],
  "postCreateCommand": "sudo chown vscode:vscode .venv && uv sync --locked",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "astral-sh.ty",
        "usernamehw.errorlens",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
